# VinoInsight AI — backend environment template
#
# HOW TO USE THIS FILE
#   Copy it to a file named exactly ".env" in this same folder, then paste your
#   own key in place of the placeholder below:
#
#       Windows (Command Prompt):   copy .env.example .env
#       macOS / Linux:              cp .env.example .env
#
#   Then open .env and replace the placeholder with your real key.
#   `python app.py` loads it automatically every time — no terminal commands.
#
# WHY THIS TEMPLATE EXISTS
#   ".env" holds a real secret and must NEVER be shared, committed, emailed, or
#   included in a submitted zip. It is listed in .gitignore, but note that
#   .gitignore only protects git — zipping this folder WILL include .env unless
#   it is explicitly excluded. A previous build of this project shipped a live
#   API key inside the distributed zip for exactly that reason.
#
#   This ".env.example" file is the safe counterpart: it contains no secret, so
#   it can be shared freely, and it documents every setting the backend reads.


# --- Google Gemini (optional) ------------------------------------------------
# Powers the live-AI path of the wine chatbot. Get a free key (no credit card)
# at https://aistudio.google.com/apikey
#
# WITHOUT a key the app still runs perfectly — the chatbot automatically uses
# its offline knowledge base (112 wine topics) and correctly reports
# ai_powered: false so no answer is ever falsely labelled AI-generated.
#
# Verify a key actually works with:  python check_gemini.py
GEMINI_API_KEY=your-key-here

# Optional: override the model fallback chain (comma-separated, tried in order).
# Leave this commented out unless a model ID has been renamed or retired.
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash


# --- MongoDB (optional) ------------------------------------------------------
# Defaults to a local MongoDB at mongodb://localhost:27017 if left unset.
# For a free MongoDB Atlas cloud database, uncomment and use your own URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
# MONGO_DB_NAME=vinoinsight
